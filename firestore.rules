rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Users can read and write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Everyone can read user data for leaderboards
      allow read: if request.auth != null;
    }
    
    // Game data (territories, etc.)
    match /game_data/{document=**} {
      // Everyone can read game data
      allow read: if request.auth != null;
      // Only authenticated users can write (for territory conquest)
      allow write: if request.auth != null;
    }
    
    // Ratings and comments
    match /ratings/{userId} {
      // Anyone can read ratings
      allow read: if request.auth != null;
      // Users can write ratings for others
      allow write: if request.auth != null;
    }
  }
}
